<?xml version="1.0" encoding="UTF-8"?>

<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.entrystore</groupId>
		<artifactId>entrystore-rest</artifactId>
		<version>6.0-SNAPSHOT</version>
	</parent>

	<artifactId>entrystore-rest-spring-boot</artifactId>
	<packaging>jar</packaging>
	<name>EntryStore REST Spring Boot App</name>

	<dependencies>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-starter-tomcat</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-saml2-service-provider</artifactId>
		</dependency>

		<!-- Boot 4 split the SAML2 relying-party auto-configuration (Saml2RelyingPartyProperties,
		     package org.springframework.boot.security.saml2.autoconfigure) out of spring-boot-autoconfigure
		     into this module; spring-boot-starter-security does not pull it transitively. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-security-saml2</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-cas</artifactId>
			<!-- cas-client-core pulls the discontinued BouncyCastle jdk15on line (frozen at 1.70,
			     never patched). Exclude it; the maintained jdk18on artifacts (managed via
			     bouncycastle.version) provide the same org.bouncycastle.* classes. -->
			<exclusions>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcpkix-jdk15on</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcprov-jdk15on</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcutil-jdk15on</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcprov-jdk15to18</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcutil-jdk15to18</artifactId>
				</exclusion>
				<exclusion>
					<groupId>org.bouncycastle</groupId>
					<artifactId>bcpkix-jdk15to18</artifactId>
				</exclusion>
			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jetty</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Provides CaffeineCacheManager (in spring-context-support) so the hand-built Caffeine
		     caches can be registered with a CacheManager and surface under the actuator /caches
		     endpoint. Cache auto-configuration stays inert without @EnableCaching. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-cache</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-log4j2</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<dependency>
			<groupId>tools.jackson.dataformat</groupId>
			<artifactId>jackson-dataformat-xml</artifactId>
		</dependency>

		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
		</dependency>

		<!-- Held at 3.0.3: 3.1.0 pulls swagger-core-jakarta 2.2.52+, which requires the Jackson 2
		     line at 2.22.x while the Boot 4.1 BOM manages 2.21.4 — requireUpperBoundDeps fails.
		     Upgrade together with the Jackson 2 bump tracked in ENTRYSTORE-1068. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
			<version>3.0.3</version>
		</dependency>

		<dependency>
			<groupId>commons-validator</groupId>
			<artifactId>commons-validator</artifactId>
			<version>1.11.0</version>
		</dependency>

		<dependency>
			<groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
			<artifactId>owasp-java-html-sanitizer</artifactId>
		</dependency>

		<!-- Imported directly by this module's own sources, but until now only reached
		     transitively through entrystore-core-impl. Declared so this module's classpath
		     does not silently break when core-impl's dependencies change. -->
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
		</dependency>

		<dependency>
			<groupId>commons-io</groupId>
			<artifactId>commons-io</artifactId>
		</dependency>

		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-lang3</artifactId>
		</dependency>

		<!-- Syndication (feed) endpoint. -->
		<dependency>
			<groupId>com.rometools</groupId>
			<artifactId>rome</artifactId>
		</dependency>

		<!-- Outgoing mail. jakarta.mail-api ships no META-INF/services/jakarta.mail.Provider, so the
		     API alone compiles but cannot send: angus-mail is the only artifact providing that SPI.
		     Declared here at runtime scope rather than relied on transitively via core-impl, so a
		     future core-impl dependency cleanup cannot silently turn every outgoing mail into a
		     NoSuchProviderException. Same pattern as the transforms modules below. -->
		<dependency>
			<groupId>jakarta.mail</groupId>
			<artifactId>jakarta.mail-api</artifactId>
		</dependency>

		<dependency>
			<groupId>org.eclipse.angus</groupId>
			<artifactId>angus-mail</artifactId>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.entrystore</groupId>
			<artifactId>entrystore-transforms-common</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.entrystore</groupId>
			<artifactId>entrystore-transforms-empty</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.entrystore</groupId>
			<artifactId>entrystore-transforms-rowstore</artifactId>
			<version>${project.version}</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Required at runtime by OpenSAML (X.509/PKCS operations behind the SAML relying-party
		     registration) and used directly by RefreshableRelyingPartyRegistrationRepositoryTest's
		     in-memory SAML metadata fixtures. Must NOT be test-scoped: a direct declaration
		     overrides the transitive compile scope from OpenSAML and would drop bcpkix (and
		     bcutil) from the runtime classpath. Version managed by the parent. -->
		<dependency>
			<groupId>org.bouncycastle</groupId>
			<artifactId>bcpkix-jdk18on</artifactId>
		</dependency>

	</dependencies>

	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>**/*.yaml</include>
					<include>**/*.html</include>
				</includes>
				<filtering>true</filtering>
			</resource>
			<!-- Binary static assets must not be filtered (filtering corrupts non-text files). -->
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>static/**</include>
				</includes>
				<filtering>false</filtering>
			</resource>
			<!-- Spring Boot service-loader registrations (spring.factories, *.imports). -->
			<resource>
				<directory>src/main/resources</directory>
				<includes>
					<include>META-INF/**</include>
				</includes>
				<filtering>false</filtering>
			</resource>
		</resources>

		<testResources>
			<testResource>
				<directory>src/test/resources</directory>
			</testResource>
		</testResources>

		<!-- With the below plugin, Maven creates also a fat JAR (uber JAR) that bundles the entire application with all dependencies
		into a single executable JAR. The resulting fat jar file size is ~170MB vs. ~300KB of non-fat jar (only compiled classes of this module) -->
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<classifier>exec</classifier>
					<!-- repackage bundles provided-scope dependencies by default. Both of these are
					     compile-time only (annotation processor / CLASS-retention annotations) and
					     are never loaded at runtime, so keep them out of the shipped jar. -->
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
						<exclude>
							<groupId>org.jetbrains</groupId>
							<artifactId>annotations</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
