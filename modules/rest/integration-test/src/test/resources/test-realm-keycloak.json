  "clients": [
    {
      "clientId": "EntrystoreDev1",
      "name": "SAML Test Client",
      "enabled": true,
      "protocol": "saml",
      "publicClient": true,
      "redirectUris": [
        "http://host.docker.internal:8181/*",
        "http://localhost:8181/*"
