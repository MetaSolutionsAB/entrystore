      "webOrigins": [
        "http://host.docker.internal:8181",
        "http://localhost:8181"
      ]
    },
    {
      "clientId": "entrystore-oidc",
      "name": "OIDC Test Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "oidc-test-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://host.docker.internal:8181/*",
        "http://localhost:8181/*"
      ],
      "baseUrl": "http://host.docker.internal:8181",
      "webOrigins": [
        "http://host.docker.internal:8181",
        "http://localhost:8181"
      ]
