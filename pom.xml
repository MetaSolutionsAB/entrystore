<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

	<!-- ================= EntryStore  ================= -->
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>org.entrystore</groupId>
	<artifactId>entrystore-parent</artifactId>
	<version>6.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>EntryStore</name>
	<url>https://entrystore.org</url>
	<description>
		EntryStore is a Linked Data-based resource and metadata management framework. It provides a reference
		implementation of the Resource and Metadata Management Model (ReM3).
	</description>
	<inceptionYear>2008</inceptionYear>

	<!-- ================= Default Properties ================= -->
	<properties>
		<java.version>25</java.version>
		<solr.version>10.0.0</solr.version>
		<rdf4j.version>5.3.2</rdf4j.version>
		<guava.version>33.6.0-jre</guava.version>
		<jsonorg.version>20260814</jsonorg.version>
		<!-- Applies to swagger-annotations-jakarta only (ENTRYSTORE-991). swagger-core-jakarta /
		     swagger-models-jakarta stay on whatever springdoc pulls in (see the springdoc version
		     in modules/rest/spring-boot/pom.xml); raising them needs Jackson 2.22.x, which the
		     Boot 4.1 BOM blocks — see ENTRYSTORE-1068. Do not add a requireSameVersions rule for
		     the three swagger artifacts until that is resolved: it would fail the build today. -->
		<swagger.version>2.2.53</swagger.version>
		<!-- Must stay below 4.0.0: OpenSAML 5.x is built against the xmlsec 3 API and breaks on
		     xmlsec 4. Check for a newer 3.0.x when reviewing dependencies. -->
		<xmlsec.version>3.0.6</xmlsec.version>
		<commonscli.version>1.11.0</commonscli.version>
		<jetbrains-annotations.version>26.1.0</jetbrains-annotations.version>
		<!-- bcprov/bcpkix/bcutil must all resolve to the same version; bcprov sometimes gets patch
		     releases the other two do not, so only move to a version published for all three. -->
		<bouncycastle.version>1.85</bouncycastle.version>
		<owasp-html-sanitizer.version>20260313.1</owasp-html-sanitizer.version>

		<!-- Override Spring-boot versions -->
		<!-- cas-client-core 4.1.1 needs commons-codec 1.22.0, above the Boot 4.1 BOM's 1.21.0 -->
		<commons-codec.version>1.22.0</commons-codec.version>

		<site.url>https://entrystore.org</site.url>
		<distribution.snapshot.url>https://entrystore.org</distribution.snapshot.url>
		<distribution.url>https://entrystore.org</distribution.url>
		<license.licenseName>apache_v2</license.licenseName>
		<maven.compiler.release>${java.version}</maven.compiler.release>
		<maven.compiler.encoding>UTF-8</maven.compiler.encoding>

		<!-- Core encoding property — used by many plugins automatically -->
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
	</properties>

	<!-- ================= Developers ================= -->
	<developers>
		<developer>
			<name>Matthias Palmér</name>
			<id>matthias</id>
			<email>matthias at metasolutions.se</email>
			<organization>MetaSolutions AB</organization>
		</developer>
		<developer>
			<name>Hannes Ebner</name>
			<id>hannes</id>
			<email>hannes at metasolutions.se</email>
			<organization>MetaSolutions AB</organization>
		</developer>
	</developers>

	<!-- ================= DistributionManagement ================= -->
	<distributionManagement>
		<repository>
			<id>libs-releases-local</id>
			<name>release repository</name>
			<url>${distribution.url}</url>
			<uniqueVersion>false</uniqueVersion>
		</repository>
		<snapshotRepository>
			<id>libs-snapshots-local</id>
			<name>snapshot repository</name>
			<url>${distribution.snapshot.url}</url>
			<uniqueVersion>false</uniqueVersion>
		</snapshotRepository>
		<site>
			<id>entrystore-website</id>
			<url>${site.url}</url>
		</site>
	</distributionManagement>

	<scm>
		<connection>scm:git:ssh://git@bitbucket.org/metasolutions/entrystore.git</connection>
		<developerConnection>scm:git:ssh://git@bitbucket.org/metasolutions/entrystore.git</developerConnection>
		<url>https://bitbucket.org/metasolutions/entrystore.git</url>
	</scm>

	<!-- ================= Modules ================= -->
	<modules>
		<module>core</module>
		<module>modules</module>
	</modules>

	<!-- ================= Licenses ================= -->
	<licenses>
		<license>
			<name>Apache License Version 2.0</name>
			<url>http://www.apache.org/licenses/</url>
			<distribution>repo</distribution>
			<comments/>
		</license>
	</licenses>

	<!-- ================= Organization ================= -->
	<organization>
		<name>MetaSolutions AB</name>
		<url>https://www.metasolutions.se</url>
	</organization>

	<!-- ================= Build ================= -->
	<build>
		<defaultGoal>install</defaultGoal>

		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.codehaus.mojo</groupId>
					<artifactId>appassembler-maven-plugin</artifactId>
					<version>2.1.0</version>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<executions>
						<execution>
							<id>attach-source</id>
							<goals>
								<goal>jar</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<version>3.6.3</version>
					<executions>
						<execution>
							<id>enforce-maven</id>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<!-- 3.8.1 is the highest minimum required by the plugins in this build
									     (dependency-check-maven 13). The wrapper pins 3.9.16. -->
									<requireMavenVersion>
										<version>3.8.1</version>
									</requireMavenVersion>
									<bannedDependencies>
										<excludes>
											<exclude>ch.qos.logback:*</exclude>
											<exclude>org.springframework.boot:spring-boot-starter-logging</exclude>
										</excludes>
										<message>Logback and spring-boot-starter-logging are banned — this project uses Log4j2. The global dependencyManagement exclusion on spring-boot-starter in the root pom should keep them off the classpath; this rule fails the build if a transitive pull somehow reintroduces them.</message>
									</bannedDependencies>
									<!-- Fails the build when a transitive dependency requests a higher version than what
									     resolves — turning a silently-forgotten version override (e.g. bouncycastle.version)
									     into a build failure once upstream surpasses our pin, forcing a conscious review. -->
									<requireUpperBoundDeps/>
								</rules>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<configuration>
						<annotationProcessorPaths>
							<path>
								<groupId>org.projectlombok</groupId>
								<artifactId>lombok</artifactId>
								<version>${lombok.version}</version>
							</path>
						</annotationProcessorPaths>
					</configuration>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- Tree-reporter 1.5.x replaced the per-charset reporter subclasses
						     (…TreeReporterUnicode) with one reporter plus a <theme> property. -->
						<statelessTestsetInfoReporter implementation="org.apache.maven.plugin.surefire.extensions.junit5.JUnit5StatelessTestsetInfoTreeReporter">
							<theme>UNICODE</theme>
						</statelessTestsetInfoReporter>
					</configuration>
					<dependencies>
						<dependency>
							<groupId>me.fabriciorby</groupId>
							<artifactId>maven-surefire-junit5-tree-reporter</artifactId>
							<version>1.5.1</version>
						</dependency>
					</dependencies>
				</plugin>
				<plugin>
					<groupId>org.owasp</groupId>
					<artifactId>dependency-check-maven</artifactId>
					<version>13.0.0</version>
					<configuration>
						<suppressionFile>dependency-check-suppressions.xml</suppressionFile>
						<skipProvidedScope>true</skipProvidedScope>
						<skipTestScope>true</skipTestScope>
						<assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
						<failBuildOnCVSS>7</failBuildOnCVSS>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.owasp</groupId>
				<artifactId>dependency-check-maven</artifactId>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.15</version>
				<executions>
					<execution>
						<id>default-prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>default-report</id>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

	<!-- ================= Repositories ================= -->
	<repositories>
		<repository>
			<id>EntryStore</id>
			<url>https://maven.entrystore.org</url>
		</repository>
		<repository>
			<id>Maven Central</id>
			<url>https://repo.maven.apache.org/maven2/</url>
		</repository>
		<repository>
			<!-- Repo needed for Spring-boot SAML2, this link explains why a separate repository is needed:
			     https://shibboleth.atlassian.net/wiki/spaces/DEV/pages/1123844333/Use+of+Maven+Central     -->
			<id>shibboleth-releases</id>
			<name>Shibboleth Releases Repository</name>
			<url>https://build.shibboleth.net/maven/releases/</url>
			<snapshots>
				<enabled>false</enabled>
			</snapshots>
		</repository>
	</repositories>
	<pluginRepositories>
		<pluginRepository>
			<id>EntryStore</id>
			<url>https://maven.entrystore.org</url>
		</pluginRepository>
		<pluginRepository>
			<id>Maven Central</id>
			<url>https://repo.maven.apache.org/maven2/</url>
		</pluginRepository>
	</pluginRepositories>

	<!-- ================= Dependencies ================= -->
	<dependencies>
		<!--
			"no-commons-logging": empty placeholder jars that shadow the real commons-logging,
			which is still requested transitively by org.springframework:spring-core, by
			commons-validator, and by commons-beanutils, so all JCL calls land on jcl-over-slf4j
			below instead of on two competing implementations.
			These 99.0-does-not-exist artifacts are NOT on Maven Central — they are served from
			https://maven.entrystore.org (declared under <repositories>). Do not "clean up" the
			odd version or the repository entry; the build stops resolving without either.
		-->
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging</artifactId>
			<version>99.0-does-not-exist</version>
		</dependency>
		<dependency>
			<groupId>commons-logging</groupId>
			<artifactId>commons-logging-api</artifactId>
			<version>99.0-does-not-exist</version>
		</dependency>
		<!-- the slf4j commons-logging replacement -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<!--<artifactId>jcl104-over-slf4j</artifactId>-->
			<artifactId>jcl-over-slf4j</artifactId>
		</dependency>
		<!-- the other slf4j jars -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>
		<!-- using log4j as backend -->
		<dependency>
			<groupId>org.apache.logging.log4j</groupId>
			<artifactId>log4j-slf4j2-impl</artifactId>
		</dependency>
		<!-- Both of the below are compile-time only: Lombok is an annotation processor (wired via
		     annotationProcessorPaths) and the JetBrains annotations are CLASS-retention, so the JVM
		     never loads them. "provided" keeps them off the runtime classpath and stops them leaking
		     to consumers of the published core-api / core-impl artifacts. Note that this alone does
		     NOT remove them from the executable jar — spring-boot-maven-plugin:repackage bundles
		     provided-scope dependencies, so they are excluded explicitly in the REST module. -->
		<dependency>
			<groupId>org.jetbrains</groupId>
			<artifactId>annotations</artifactId>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.json</groupId>
				<artifactId>json</artifactId>
				<version>${jsonorg.version}</version>
			</dependency>
			<dependency>
				<!-- upgrading from the transitive 1.9.4, included by old opencsv -->
				<groupId>commons-beanutils</groupId>
				<artifactId>commons-beanutils</artifactId>
				<version>1.11.0</version>
			</dependency>
			<dependency>
				<groupId>commons-collections</groupId>
				<artifactId>commons-collections</artifactId>
				<version>3.2.2</version>
			</dependency>
			<!-- TODO: upgrade commons to org.apache.commons group -->
			<dependency>
				<groupId>commons-io</groupId>
				<artifactId>commons-io</artifactId>
				<version>2.22.0</version>
			</dependency>
			<dependency>
				<groupId>commons-cli</groupId>
				<artifactId>commons-cli</artifactId>
				<version>${commonscli.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.commons</groupId>
				<artifactId>commons-text</artifactId>
				<version>1.15.0</version>
			</dependency>
			<dependency>
				<groupId>io.swagger.core.v3</groupId>
				<artifactId>swagger-annotations-jakarta</artifactId>
				<version>${swagger.version}</version>
			</dependency>
			<dependency>
				<groupId>org.apache.santuario</groupId>
				<artifactId>xmlsec</artifactId>
				<version>${xmlsec.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.guava</groupId>
				<artifactId>guava</artifactId>
				<version>${guava.version}</version>
			</dependency>
			<dependency>
				<groupId>com.google.errorprone</groupId>
				<artifactId>error_prone_annotations</artifactId>
				<version>2.50.0</version>
			</dependency>
			<dependency>
				<groupId>org.jetbrains</groupId>
				<artifactId>annotations</artifactId>
				<version>${jetbrains-annotations.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcprov-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcpkix-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>org.bouncycastle</groupId>
				<artifactId>bcutil-jdk18on</artifactId>
				<version>${bouncycastle.version}</version>
			</dependency>
			<dependency>
				<groupId>com.googlecode.owasp-java-html-sanitizer</groupId>
				<artifactId>owasp-java-html-sanitizer</artifactId>
				<version>${owasp-html-sanitizer.version}</version>
			</dependency>
			<dependency>
				<!-- Used by the REST layer only (syndication endpoint / feed generation);
				     managed here so the version is not repeated at the declaration. -->
				<groupId>com.rometools</groupId>
				<artifactId>rome</artifactId>
				<version>1.19.0</version>
			</dependency>
			<dependency>
				<!-- Global exclusion: every spring-boot-starter-* pulls spring-boot-starter, which
					 pulls spring-boot-starter-logging (Logback + bridges). We use Log4j2 instead. -->
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-starter</artifactId>
				<exclusions>
					<exclusion>
						<groupId>org.springframework.boot</groupId>
						<artifactId>spring-boot-starter-logging</artifactId>
					</exclusion>
				</exclusions>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
