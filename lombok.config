config.stopBubbling = true

# Copy @Qualifier onto Lombok-generated constructor parameters (e.g. @RequiredArgsConstructor),
# so constructor injection honors the qualifier. Without this Lombok drops field-level @Qualifier,
# and Spring would fall back to by-type / parameter-name matching — which a @Primary bean overrides.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
